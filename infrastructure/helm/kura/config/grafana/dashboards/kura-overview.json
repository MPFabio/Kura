{
  "uid": "kura-overview",
  "title": "Kura — Platform Overview",
  "tags": ["kura", "devops"],
  "timezone": "browser",
  "refresh": "30s",
  "schemaVersion": 38,
  "version": 2,
  "panels": [
    {
      "id": 10,
      "title": "Latence P95 (SLO 200 ms)",
      "type": "stat",
      "description": "95e percentile de la latence mesuree par Kong. Le seuil orange est place a 150 ms pour laisser une marge d'investigation avant le SLO.",
      "gridPos": { "h": 4, "w": 5, "x": 0, "y": 0 },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 150 },
              { "color": "red", "value": 200 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(kong_kong_latency_ms_bucket[5m])) by (le))",
          "legendFormat": "P95",
          "refId": "A"
        }
      ],
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },
    {
      "id": 11,
      "title": "Taux d'erreurs 5xx",
      "type": "stat",
      "description": "Part des reponses 5xx sur le total, mesuree par Kong. clamp_min evite la division par zero quand aucun trafic n'arrive.",
      "gridPos": { "h": 4, "w": 5, "x": 5, "y": 0 },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.5 },
              { "color": "red", "value": 2 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "100 * sum(rate(kong_http_requests_total{code=~\"5..\"}[5m])) / clamp_min(sum(rate(kong_http_requests_total[5m])), 0.001)",
          "legendFormat": "5xx",
          "refId": "A"
        }
      ],
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },
    {
      "id": 12,
      "title": "Error budget consommé (30 j)",
      "type": "gauge",
      "description": "Part du budget d'erreur depensee sous un SLO de 99 %. Calcule sur les requetes servies et non sur l'etat des processus : un redeploiement de quelques secondes ne fait echouer aucune requete.",
      "gridPos": { "h": 4, "w": 5, "x": 10, "y": 0 },
      "options": {
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 50 },
              { "color": "red", "value": 80 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "100 * sum(increase(kong_http_requests_total{code=~\"5..\"}[30d])) / clamp_min(sum(increase(kong_http_requests_total[30d])), 1) / 0.01",
          "legendFormat": "Budget consomme",
          "refId": "A"
        }
      ],
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },
    {
      "id": 1,
      "title": "Services en ligne",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 15, "y": 0 },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 6 },
              { "color": "green", "value": 8 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "count(up{job=~\".+-service\"} == 1) or vector(0)",
          "legendFormat": "En ligne",
          "refId": "A"
        }
      ],
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },
    {
      "id": 2,
      "title": "Services hors ligne",
      "type": "stat",
      "description": "Reste neutre a zero : un pave colore sur une valeur saine apprend a ignorer la couleur.",
      "gridPos": { "h": 4, "w": 5, "x": 19, "y": 0 },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "text", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "red", "value": 2 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "count(up{job=~\".+-service\"} == 0) or vector(0)",
          "legendFormat": "Hors ligne",
          "refId": "A"
        }
      ],
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },
    {
      "id": 7,
      "title": "Disponibilité par service",
      "type": "state-timeline",
      "description": "Frise d'etats plutot qu'un graphe : huit series binaires a la meme valeur se superposent et n'affichent qu'une seule ligne.",
      "gridPos": { "h": 7, "w": 24, "x": 0, "y": 4 },
      "options": {
        "showValue": "never",
        "mergeValues": true,
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 1,
          "mappings": [
            { "type": "value", "options": { "0": { "text": "Hors ligne", "color": "red", "index": 0 } } },
            { "type": "value", "options": { "1": { "text": "En ligne", "color": "green", "index": 1 } } }
          ]
        }
      },
      "targets": [
        {
          "expr": "up{job=~\".+-service\"}",
          "legendFormat": "{{job}}",
          "refId": "A"
        }
      ],
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },
    {
      "id": 13,
      "title": "Latence P95 par route",
      "type": "timeseries",
      "description": "Identifie la route qui porte le P95 global.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 11 },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": { "unit": "ms" }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(kong_kong_latency_ms_bucket[5m])) by (le, service))",
          "legendFormat": "{{service}}",
          "refId": "A"
        }
      ],
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },
    {
      "id": 14,
      "title": "Requêtes par code de statut",
      "type": "timeseries",
      "description": "Trafic par code : le volume donne l'echelle a laquelle lire le taux d'erreurs.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 11 },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": { "unit": "reqps" }
      },
      "targets": [
        {
          "expr": "sum(rate(kong_http_requests_total[5m])) by (code)",
          "legendFormat": "{{code}}",
          "refId": "A"
        }
      ],
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },
    {
      "id": 5,
      "title": "Goroutines par service",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 19 },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": { "unit": "short" }
      },
      "targets": [
        {
          "expr": "go_goroutines{job=~\".+-service\"}",
          "legendFormat": "{{job}}",
          "refId": "A"
        }
      ],
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },
    {
      "id": 6,
      "title": "Mémoire RSS par service",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 19 },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": { "unit": "bytes" }
      },
      "targets": [
        {
          "expr": "process_resident_memory_bytes{job=~\".+-service\"}",
          "legendFormat": "{{job}}",
          "refId": "A"
        }
      ],
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    }
  ]
}
